rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(roles) {
      return request.auth != null && request.auth.token.get('role', '') in roles;
    }
    function finance() { return hasRole(['Super Admin', 'Finance Manager']); }
    function warehouse() { return hasRole(['Super Admin', 'Warehouse Manager']); }

    match /purchaseOrders/{poId} {
      allow read: if hasRole(['Super Admin', 'Finance Manager', 'Warehouse Manager']);
      // Creation is validated item-by-item by the server, which uses Admin SDK.
      allow create: if false;

      allow update: if (
        finance() && resource.data.status == 'Pending Approval'
        && request.resource.data.status in ['Disetujui', 'Ditolak']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'color', 'lastMutationId'])
      ) || (
        finance() && resource.data.status == 'Barang Diterima'
        && resource.data.threeWayMatchStatus == 'MATCHED'
        // Receipts and this verification marker are written only by the trusted server.
        && resource.data.get('receiptVerification', {}).get('version', 0) == 1
        && !('paymentInfo' in resource.data)
        && request.resource.data.status == 'Selesai'
        && request.resource.data.paymentInfo.amount == resource.data.total
        && request.resource.data.paymentInfo.txId is string
        && request.resource.data.paymentInfo.receiptNo is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'color', 'paymentInfo'])
      );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
