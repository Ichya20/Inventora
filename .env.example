# Environment variables for Inventora
GEMINI_API_KEY=
# Models used by the server. Set fallback to 'none' to use only the primary model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Optional. Defaults to the Firebase project in firebase-applet-config.json.
FIREBASE_PROJECT_ID=
# Server only: path to a service-account JSON with Firestore access, kept outside the repository.
# A deployed server can use its attached service account (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=
